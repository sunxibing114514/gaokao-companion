<Window x:Class="GaokaoCompanion.Windows.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="高考倒计时"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border x:Name="RootBorder"
            CornerRadius="18"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            Padding="18,12"
            Margin="6"
            PreviewMouseLeftButtonDown="OnRootMouseLeftButtonDown"
            PreviewMouseMove="OnRootMouseMove"
            PreviewMouseLeftButtonUp="OnRootMouseLeftButtonUp">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.45"/>
        </Border.Effect>
        <Border.ContextMenu>
            <ContextMenu x:Name="WidgetMenu" Style="{StaticResource M3Menu}">
                <MenuItem Header="下一句" Style="{StaticResource M3MenuItem}" Click="OnNextSentenceClick"/>
                <MenuItem Header="刷新数据" Style="{StaticResource M3MenuItem}" Click="OnRefreshDataClick"/>
                <MenuItem Header="打开设置" Style="{StaticResource M3MenuItem}" Click="OnOpenSettingsClick"/>
                <MenuItem Header="关闭倒计时" Style="{StaticResource M3MenuItem}" Click="OnCloseWidgetClick"/>
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="CountdownText"
                       Text="距离高考还有…"
                       Foreground="#FF000000"
                       FontSize="30"
                       MaxWidth="720"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="SeparatorText"
                       Text="丨"
                       Foreground="#FF000000"
                       FontSize="30"
                       Margin="2,0"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="SentenceText"
                       Text="加载中…"
                       Foreground="#FF000000"
                       FontSize="24"
                       MaxWidth="560"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
