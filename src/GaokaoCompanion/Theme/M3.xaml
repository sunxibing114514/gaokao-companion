<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= Material Design 3 暗色配色 ================= -->
    <SolidColorBrush x:Key="Primary" Color="#D0BCFF"/>
    <SolidColorBrush x:Key="OnPrimary" Color="#381E72"/>
    <SolidColorBrush x:Key="PrimaryContainer" Color="#4F378B"/>
    <SolidColorBrush x:Key="OnPrimaryContainer" Color="#EADDFF"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#E2D3FF"/>
    <SolidColorBrush x:Key="PrimaryPressed" Color="#BCA3EF"/>
    <SolidColorBrush x:Key="SecondaryContainer" Color="#4A4458"/>
    <SolidColorBrush x:Key="OnSecondaryContainer" Color="#E8DEF8"/>
    <SolidColorBrush x:Key="Surface" Color="#141218"/>
    <SolidColorBrush x:Key="SurfaceContainer" Color="#211F26"/>
    <SolidColorBrush x:Key="SurfaceContainerHigh" Color="#2B2930"/>
    <SolidColorBrush x:Key="OnSurface" Color="#E6E1E9"/>
    <SolidColorBrush x:Key="OnSurfaceVariant" Color="#CAC4D0"/>
    <SolidColorBrush x:Key="Outline" Color="#938F99"/>
    <SolidColorBrush x:Key="OutlineVariant" Color="#49454F"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F2B8B5"/>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ================= 文本 ================= -->
    <Style x:Key="M3SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,18,0,8"/>
    </Style>

    <Style x:Key="M3FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariant}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="2,8,0,4"/>
    </Style>

    <!-- ================= 卡片 ================= -->
    <Style x:Key="M3Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceContainerHigh}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- ================= 按钮(实心) ================= -->
    <Style x:Key="M3Button" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Primary}"/>
        <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="20,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="20" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceContainerHigh}"/>
                            <Setter Property="Foreground" Value="{StaticResource Outline}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 按钮(文本) ================= -->
    <Style x:Key="M3TextButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Primary}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="20" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1FD0BCFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33D0BCFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 图标按钮 ================= -->
    <Style x:Key="M3IconButton" TargetType="Button" BasedOn="{StaticResource M3TextButton}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
    </Style>

    <!-- ================= 文本框 ================= -->
    <Style x:Key="M3TextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        <Setter Property="CaretBrush" Value="{StaticResource OnSurface}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceContainer}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource OnSurfaceVariant}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 列表项 ================= -->
    <Style x:Key="M3ListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="12" Padding="14,9" Margin="2,2" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22CAC4D0"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SecondaryContainer}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 列表 ================= -->
    <Style x:Key="M3ListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource M3ListItem}"/>
    </Style>

    <!-- ================= 开关 ================= -->
    <Style x:Key="M3Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track" Width="46" Height="26" CornerRadius="13" Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource Outline}" BorderThickness="2">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{StaticResource Outline}" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Primary}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource OnPrimary}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 右键菜单 ================= -->
    <Style x:Key="M3Menu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource SurfaceContainerHigh}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OutlineVariant}"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="6" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="5">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M3MenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" CornerRadius="9" Padding="14,8" Background="Transparent">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26D0BCFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
